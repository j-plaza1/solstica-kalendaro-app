<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolsticaKalendaro.App.AboutPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Paper}">

    <ScrollView>
        <VerticalStackLayout Padding="20,10,20,34" Spacing="0">

            <Button x:Name="BackButton" Clicked="OnBackClicked" Text="‹"
                    FontFamily="Plex" FontSize="18" TextColor="{StaticResource Muted}"
                    BackgroundColor="Transparent" BorderWidth="0" Padding="0,10"
                    MinimumHeightRequest="44" MinimumWidthRequest="44"
                    HorizontalOptions="Start" />

            <Label x:Name="TitleLabel" FontFamily="SpectralSemiBold" FontSize="32"
                   TextColor="{StaticResource Ink}" Margin="0,12,0,0" />

            <!-- The calendar's own name, which is not translated, and who proposed it. -->
            <Label Text="Solstica Kalendaro" FontFamily="SpectralSemiBold" FontSize="21"
                   TextColor="{StaticResource Ink}" Margin="0,26,0,0" />
            <Label x:Name="TaglineLabel" FontFamily="Plex" FontSize="13"
                   TextColor="{StaticResource Muted}" Margin="0,5,0,0" />
            <Label x:Name="AuthorLabel" FontFamily="Plex" FontSize="13"
                   TextColor="{StaticResource Muted}" Margin="0,2,0,0" />

            <Label x:Name="AppHeading" FontFamily="PlexSemiBold" FontSize="10"
                   CharacterSpacing="0.9" TextColor="{StaticResource Faint}" Margin="0,30,0,6" />
            <Label x:Name="VersionLabel" FontFamily="Plex" FontSize="14"
                   TextColor="{StaticResource Ink}" />
            <Button x:Name="ReleasesButton" Clicked="OnNewVersions"
                    FontFamily="PlexMedium" FontSize="13" TextColor="{StaticResource Accent}"
                    BackgroundColor="Transparent" BorderWidth="0" Padding="0,10"
                    MinimumHeightRequest="44" HorizontalOptions="Start" Margin="0,6,0,0" />
            <Button x:Name="SourceButton" Clicked="OnSourceCode"
                    FontFamily="PlexMedium" FontSize="13" TextColor="{StaticResource Accent}"
                    BackgroundColor="Transparent" BorderWidth="0" Padding="0,10"
                    MinimumHeightRequest="44" HorizontalOptions="Start" />

            <Label x:Name="ArticleHeading" FontFamily="PlexSemiBold" FontSize="10"
                   CharacterSpacing="0.9" TextColor="{StaticResource Faint}" Margin="0,24,0,6" />
            <Label x:Name="ArticleLabel" FontFamily="Plex" FontSize="14"
                   TextColor="{StaticResource Ink}" />
            <Button x:Name="ArticleButton" Clicked="OnReadArticle"
                    FontFamily="PlexMedium" FontSize="13" TextColor="{StaticResource Accent}"
                    BackgroundColor="Transparent" BorderWidth="0" Padding="0,10"
                    MinimumHeightRequest="44" HorizontalOptions="Start" Margin="0,6,0,0" />

            <Label x:Name="LicencesHeading" FontFamily="PlexSemiBold" FontSize="10"
                   CharacterSpacing="0.9" TextColor="{StaticResource Faint}" Margin="0,24,0,6" />
            <Label x:Name="LicencesLabel" FontFamily="Plex" FontSize="11.5" LineHeight="1.4"
                   TextColor="{StaticResource Muted}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
