<?xml version="1.0" encoding="utf-8" ?>

<!-- The rows of a year, drawn the same wherever a year is drawn: the view itself, and the
     example inside the introduction, which has to look exactly like what it explains. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:local="clr-namespace:SolsticaKalendaro.App">


    <!-- Each template declares a fixed height. Rows that never change size make
         scrolling by index exact, which is what going to today depends on. The heights and
         the sizes come from the application's resources, where TextScale has already scaled
         them by the system's font setting; the text itself does not scale again, which is
         what FontAutoScalingEnabled="False" says everywhere below. -->

    <DataTemplate x:Key="SectionTemplate">
        <HorizontalStackLayout Padding="20,15,20,7" Spacing="8"
                               HeightRequest="{StaticResource RowSectionHeight}">
            <Ellipse Fill="{Binding Dot}" WidthRequest="8" HeightRequest="8"
                     VerticalOptions="Center" />
            <Label Text="{Binding Name}" FontFamily="SpectralSemiBold"
                   FontSize="{StaticResource SizeSectionName}" FontAutoScalingEnabled="False"
                   TextColor="{DynamicResource Ink}" VerticalOptions="Center" />
            <Label Text="{Binding Label}" IsVisible="{Binding HasLabel}"
                   FontFamily="Plex" FontSize="{StaticResource SizeSectionLabel}"
                   FontAutoScalingEnabled="False"
                   TextColor="{DynamicResource Muted}" VerticalOptions="Center" />
        </HorizontalStackLayout>
    </DataTemplate>

    <DataTemplate x:Key="WeekTemplate">
        <Grid Padding="12,0" ColumnDefinitions="*,*,*,*,*,*,*"
              HeightRequest="{StaticResource RowWeekHeight}"
              BindableLayout.ItemsSource="{Binding Days}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Grid Grid.Column="{Binding Column}" RowDefinitions="*,4"
                          HeightRequest="{StaticResource RowWeekHeight}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=OpenDay}"
                                CommandParameter="{Binding Solstica}" />
                        </Grid.GestureRecognizers>

                        <!-- A free day is shaded, whatever makes it one. Today is not: it is
                             the circle below, so that a day can be both at once. -->
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsDayOff}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource DayOffShade}" />
                            </DataTrigger>
                        </Grid.Triggers>

                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">

                            <!-- A fixed square, so that neither the circle nor the weight of
                                 a free day's number can push the row past its height. -->
                            <Grid HeightRequest="{StaticResource TodayCircleSize}"
                                  WidthRequest="{StaticResource TodayCircleSize}"
                                  HorizontalOptions="Center">
                                <Ellipse Fill="{DynamicResource Ink}"
                                         WidthRequest="{StaticResource TodayCircleSize}"
                                         HeightRequest="{StaticResource TodayCircleSize}"
                                         IsVisible="{Binding IsToday}" />
                                <Label Text="{Binding Number}" FontFamily="Plex"
                                       FontSize="{StaticResource SizeDayNumber}"
                                       FontAutoScalingEnabled="False"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       TextColor="{DynamicResource Ink}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDayOff}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource DayOffRed}" />
                                            <Setter Property="FontFamily" Value="PlexSemiBold" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource Paper}" />
                                            <Setter Property="FontFamily" Value="PlexSemiBold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Label Text="{Binding Gregorian}" FontFamily="Plex"
                                   FontSize="{StaticResource SizeDayGregorian}"
                                   FontAutoScalingEnabled="False"
                                   HorizontalOptions="Center" TextColor="{DynamicResource Faint}" />
                        </VerticalStackLayout>

                        <!-- The season of the day, at its foot. It can change mid-row. -->
                        <BoxView Grid.Row="1" Color="{Binding Season}" />

                        <!-- The day just gone to. An outline, because today is a fill and
                             one day can be both; drawn inside the cell, so it takes none
                             of the fixed height away from anything. -->
                        <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsMarked}"
                                InputTransparent="True" BackgroundColor="Transparent"
                                Stroke="{DynamicResource Mark}" StrokeThickness="2" />

                        <BoxView Grid.Row="0" Color="{DynamicResource CellEdge}"
                                 WidthRequest="1" HorizontalOptions="End" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </Grid>
    </DataTemplate>

    <!-- Extra-weekly days are not cells: they cross all seven columns, because that is
         what they are. Outside the week, between the blocks. -->
    <DataTemplate x:Key="BandTemplate">
        <Grid Margin="12,6" ColumnDefinitions="4,*,4"
              HeightRequest="{StaticResource RowBandHeight}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=OpenDay}"
                    CommandParameter="{Binding Solstica}" />
            </Grid.GestureRecognizers>
            <BoxView Color="{Binding Season}" />
            <!-- A day outside the week is a festivity, so the band is shaded and named in
                 the same red as a free day's number. -->
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="14,13"
                  BackgroundColor="{DynamicResource DayOffShade}">
                <VerticalStackLayout Spacing="3">
                    <Label Text="{Binding Name}" FontFamily="SpectralSemiBold"
                           FontSize="{StaticResource SizeBandName}" FontAutoScalingEnabled="False"
                           TextColor="{DynamicResource DayOffRed}" />
                    <Label Text="{Binding Note}" FontFamily="Plex"
                           FontSize="{StaticResource SizeBandNote}" FontAutoScalingEnabled="False"
                           TextColor="{DynamicResource Muted}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="{Binding Gregorian}" FontFamily="Plex"
                       FontSize="{StaticResource SizeBandDate}" FontAutoScalingEnabled="False"
                       TextColor="{DynamicResource Ink}" VerticalOptions="Center" />
            </Grid>
            <BoxView Grid.Column="2" Color="{Binding Season}" />

            <!-- A Jarfino or a Supertago is a band, not a cell, so the mark goes round
                 the whole of it. -->
            <Border Grid.ColumnSpan="3" IsVisible="{Binding IsMarked}"
                    InputTransparent="True" BackgroundColor="Transparent"
                    Stroke="{DynamicResource Mark}" StrokeThickness="2" />
        </Grid>
    </DataTemplate>

    <local:RowTemplateSelector x:Key="RowSelector"
                               Section="{StaticResource SectionTemplate}"
                               Week="{StaticResource WeekTemplate}"
                               Band="{StaticResource BandTemplate}" />
</ResourceDictionary>
