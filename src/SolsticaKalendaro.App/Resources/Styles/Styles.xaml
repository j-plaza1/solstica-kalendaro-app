<?xml version="1.0" encoding="UTF-8" ?>

<!-- What the controls look like before any page says otherwise. The template's own styles and
     its palette of purples and greys are gone: every colour here is one of the pairs in
     Palette, asked for with DynamicResource so that a change of theme reaches a page already
     on screen.

     Only the controls the app actually uses are styled. A style for something it does not use
     is a claim about a screen that does not exist. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Paper}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource Paper}" />
        <Setter Property="BarTextColor" Value="{DynamicResource Ink}" />
        <Setter Property="IconColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="Plex" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Plex" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource Muted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource Hairline}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{DynamicResource CardEdge}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- The three the Go to panel asks a day of. Their own dialogs are the platform's, and on
         Android those follow colorPrimary and colorAccent, which the theme's colors.xml sets
         to the same pairs. -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Plex" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="TitleColor" Value="{DynamicResource Muted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Plex" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Plex" />
    </Style>

    <!-- The introduction's three screens and their dots. -->
    <Style TargetType="CarouselView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource Hairline}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="CollectionView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

</ResourceDictionary>
