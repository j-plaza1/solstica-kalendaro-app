<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SolsticaKalendaro.App"
             x:Class="SolsticaKalendaro.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/Rows.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The year view's own sizes, at the ordinary text size. TextScale.Apply
                 multiplies them by the system's font setting before any page is built, up to
                 the limit the seven columns allow, and the heights stay whole numbers: every
                 row declares one, and scrolling to a day by index depends on that. -->
            <x:Double x:Key="RowSectionHeight">44</x:Double>
            <x:Double x:Key="RowWeekHeight">58</x:Double>
            <x:Double x:Key="RowBandHeight">66</x:Double>
            <x:Double x:Key="TodayCircleSize">28</x:Double>

            <x:Double x:Key="SizeSectionName">16</x:Double>
            <x:Double x:Key="SizeSectionLabel">11</x:Double>
            <x:Double x:Key="SizeDayNumber">19</x:Double>
            <x:Double x:Key="SizeDayGregorian">10</x:Double>
            <x:Double x:Key="SizeBandName">17</x:Double>
            <x:Double x:Key="SizeBandNote">11</x:Double>
            <x:Double x:Key="SizeBandDate">12.5</x:Double>
            <x:Double x:Key="SizeWeekdayInitial">10.5</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
