<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolsticaKalendaro.App.DayDetailPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Paper}">

    <ScrollView>
        <VerticalStackLayout Padding="20,10,20,30" Spacing="0">

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Button x:Name="BackButton" Clicked="OnBackClicked"
                            FontFamily="Plex" FontSize="12.5" TextColor="{DynamicResource Muted}"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0,10"
                        MinimumHeightRequest="44" HorizontalOptions="Start" />
                <Label x:Name="PositionLabel" Grid.Column="2" FontFamily="Plex" FontSize="11"
                       TextColor="{DynamicResource Muted}" VerticalOptions="Center" />
            </Grid>

            <!-- A festivity is never in the upcoming list once it has arrived, so the day has
                 to announce its own. -->
            <Label x:Name="FestivityLabel" FontFamily="SpectralSemiBold" FontSize="15"
                   TextColor="{DynamicResource Accent}" Margin="0,16,0,0" IsVisible="False" />

            <!-- Why the day is free, one line per reason. The grid marks them all alike; this
                 is where the reasons are told apart. -->
            <VerticalStackLayout x:Name="DayOffReasons" Spacing="1" Margin="0,10,0,0" />

            <Label x:Name="WeekDayLabel" FontFamily="PlexMedium" FontSize="12"
                   CharacterSpacing="0.9" Margin="0,16,0,5" />

            <VerticalStackLayout Spacing="0">
                <Label x:Name="DateLabel" FontFamily="SpectralSemiBold" FontSize="42"
                       TextColor="{DynamicResource Ink}" />
                <Label x:Name="DateYearLabel" FontFamily="SpectralSemiBold" FontSize="42"
                       TextColor="{DynamicResource Ink}" Margin="0,-10,0,0" />
            </VerticalStackLayout>

            <Border Margin="0,20,0,0" StrokeThickness="0" BackgroundColor="{DynamicResource CardFill}"
                    StrokeShape="RoundRectangle 12" Padding="17,15">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="GregorianHeading" FontFamily="PlexSemiBold" FontSize="10"
                           CharacterSpacing="0.9" TextColor="{DynamicResource Faint}" />
                    <Label x:Name="GregorianLabel" FontFamily="Spectral" FontSize="21"
                           TextColor="{DynamicResource Ink}" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="DivergenceCard" Margin="0,13,0,0" IsVisible="False"
                    Stroke="{DynamicResource CardEdge}" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                    Padding="17,14">
                <VerticalStackLayout Spacing="5">
                    <Label x:Name="DivergenceTitle" FontFamily="PlexSemiBold" FontSize="12.5"
                           TextColor="{DynamicResource Ink}" />
                    <Label x:Name="DivergenceBody" FontFamily="Plex" FontSize="11.5"
                           LineHeight="1.45" TextColor="{DynamicResource CardText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Heading at one end and the season at the other while they fit on a line, and
                 one under the other when the text is large enough that they do not: in a grid
                 the season's own width squeezed the heading into a column of its own. -->
            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween"
                        Margin="0,22,0,9">
                <Label x:Name="SeasonHeading" FontFamily="PlexSemiBold" FontSize="10"
                       CharacterSpacing="0.9" TextColor="{DynamicResource Faint}"
                       VerticalOptions="Center" />
                <Label x:Name="SeasonLabel" FontFamily="Plex" FontSize="11.5"
                       TextColor="{DynamicResource Body}" VerticalOptions="Center" />
            </FlexLayout>

            <!-- The segments are the real season lengths of this year, so the bar is the
                 allocation of the period drawn to scale, not four equal quarters. -->
            <Grid HeightRequest="18">
                <Border HeightRequest="9" VerticalOptions="Center" StrokeThickness="0"
                        StrokeShape="RoundRectangle 5">
                    <Grid x:Name="SeasonBar" />
                </Border>
                <AbsoluteLayout>
                    <BoxView x:Name="Marker" Color="{DynamicResource Ink}" WidthRequest="3"
                             AbsoluteLayout.LayoutFlags="XProportional"
                             AbsoluteLayout.LayoutBounds="0,0,3,18" />
                </AbsoluteLayout>
            </Grid>

            <AbsoluteLayout x:Name="DegreeRow" HeightRequest="16" Margin="0,4,0,0" />

            <Label x:Name="FestivitiesTitle" FontFamily="PlexSemiBold" FontSize="10"
                   CharacterSpacing="0.9" TextColor="{DynamicResource Faint}" Margin="0,24,0,8" />

            <VerticalStackLayout x:Name="Festivities" Spacing="0" />

            <BoxView Color="{DynamicResource Hairline}" HeightRequest="1" Margin="0,22,0,12" />

            <!-- The line that names the period is the way to it. -->
            <Label x:Name="FooterLabel" FontFamily="Plex" FontSize="10.5"
                   TextColor="{DynamicResource Muted}" Padding="0,14"
                   MinimumHeightRequest="44">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPeriodTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
