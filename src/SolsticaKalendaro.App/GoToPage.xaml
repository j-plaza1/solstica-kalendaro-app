<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolsticaKalendaro.App.GoToPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,10,20,0">

        <Grid ColumnDefinitions="Auto,*">
            <Button x:Name="BackButton" Clicked="OnBackClicked" Text="‹"
                    FontFamily="Plex" FontSize="18" TextColor="{StaticResource Muted}"
                    BackgroundColor="Transparent" BorderWidth="0" Padding="0,10"
                    MinimumHeightRequest="44" MinimumWidthRequest="44"
                    HorizontalOptions="Start" />
            <Label x:Name="TitleLabel" Grid.Column="1" FontFamily="SpectralSemiBold" FontSize="22"
                   TextColor="{StaticResource Ink}" VerticalOptions="Center" Margin="4,0,0,0" />
        </Grid>

        <!-- Three tabs, one panel: Year and Period below, Date still to come (#16). -->
        <Grid x:Name="Tabs" Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,16,0,0">
            <Button x:Name="YearTab" Clicked="OnTabClicked" />
            <Button x:Name="PeriodTab" Grid.Column="1" Clicked="OnTabClicked" />
            <Button x:Name="DateTab" Grid.Column="2" Clicked="OnTabClicked" />
            <BoxView Grid.ColumnSpan="3" Color="{StaticResource Hairline}" HeightRequest="1"
                     VerticalOptions="End" />
            <BoxView x:Name="TabUnderline" Color="{StaticResource Accent}" HeightRequest="2"
                     VerticalOptions="End" />
        </Grid>

        <Grid Grid.Row="2">

            <!-- A year, typed. The range underneath is the answer to "which years are there",
                 which is otherwise only discoverable by trying one. -->
            <VerticalStackLayout x:Name="YearPanel" Spacing="0" Margin="0,28,0,0">
                <Entry x:Name="YearEntry" Keyboard="Numeric" MaxLength="5"
                       FontFamily="Plex" FontSize="28" TextColor="{StaticResource Ink}"
                       BackgroundColor="Transparent" WidthRequest="170"
                       HorizontalOptions="Start" MinimumHeightRequest="44"
                       Focused="OnYearFocused" TextChanged="OnYearChanged"
                       Completed="OnYearCompleted" />
                <Label x:Name="YearRangeLabel" FontFamily="Plex" FontSize="11"
                       TextColor="{StaticResource Muted}" Margin="2,6,0,0" />
                <Button x:Name="GoButton" Clicked="OnGoClicked"
                        FontFamily="PlexMedium" FontSize="13"
                        MinimumHeightRequest="44" Padding="20,9" CornerRadius="22"
                        BorderWidth="1" BorderColor="{StaticResource Rule}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Ink}"
                        HorizontalOptions="Start" Margin="0,26,0,0" />
            </VerticalStackLayout>

            <!-- Eleven rows: more than a short screen holds, so they scroll. -->
            <ScrollView x:Name="PeriodPanel" IsVisible="False">
                <VerticalStackLayout x:Name="Periods" Spacing="0" Margin="0,8,8,24" />
            </ScrollView>

            <!-- The third tab, for #16. -->
            <ContentView x:Name="DatePanel" IsVisible="False" />

        </Grid>

    </Grid>

</ContentPage>
