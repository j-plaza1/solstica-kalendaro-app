<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SolsticaKalendaro.App.GoToPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,10,20,0">

        <Grid ColumnDefinitions="Auto,*">
            <Button x:Name="BackButton" Clicked="OnBackClicked" Text="‹"
                    FontFamily="Plex" FontSize="18" TextColor="{DynamicResource Muted}"
                    BackgroundColor="Transparent" BorderWidth="0" Padding="0,10"
                    MinimumHeightRequest="44" MinimumWidthRequest="44"
                    HorizontalOptions="Start" />
            <Label x:Name="TitleLabel" Grid.Column="1" FontFamily="SpectralSemiBold" FontSize="22"
                   TextColor="{DynamicResource Ink}" VerticalOptions="Center" Margin="4,0,0,0" />
        </Grid>

        <!-- Three tabs, one panel: Year and Period below, Date still to come (#16). -->
        <Grid x:Name="Tabs" Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,16,0,0">
            <Button x:Name="YearTab" LineBreakMode="WordWrap" Clicked="OnTabClicked" />
            <Button x:Name="PeriodTab" LineBreakMode="WordWrap" Grid.Column="1" Clicked="OnTabClicked" />
            <Button x:Name="DateTab" LineBreakMode="WordWrap" Grid.Column="2" Clicked="OnTabClicked" />
            <BoxView Grid.ColumnSpan="3" Color="{DynamicResource Hairline}" HeightRequest="1"
                     VerticalOptions="End" />
            <BoxView x:Name="TabUnderline" Color="{DynamicResource Accent}" HeightRequest="2"
                     VerticalOptions="End" />
        </Grid>

        <Grid Grid.Row="2">

            <!-- A year, typed. The range underneath is the answer to "which years are there",
                 which is otherwise only discoverable by trying one. -->
            <VerticalStackLayout x:Name="YearPanel" Spacing="0" Margin="0,28,0,0">
                <Entry x:Name="YearEntry" Keyboard="Numeric" MaxLength="5"
                       FontFamily="Plex" FontSize="28" TextColor="{DynamicResource Ink}"
                       BackgroundColor="Transparent" MinimumWidthRequest="170"
                       HorizontalOptions="Start" MinimumHeightRequest="44" />
                <Label x:Name="YearRangeLabel" FontFamily="Plex" FontSize="11"
                       TextColor="{DynamicResource Muted}" Margin="2,6,0,0" />
                <Button x:Name="GoButton" LineBreakMode="WordWrap" Clicked="OnGoClicked"
                        FontFamily="PlexMedium" FontSize="13"
                        MinimumHeightRequest="44" Padding="20,9" CornerRadius="22"
                        BorderWidth="1" BorderColor="{DynamicResource Rule}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource Ink}"
                        HorizontalOptions="Start" Margin="0,26,0,0" />
            </VerticalStackLayout>

            <!-- Eleven rows: more than a short screen holds, so they scroll. -->
            <ScrollView x:Name="PeriodPanel" IsVisible="False">
                <VerticalStackLayout x:Name="Periods" Spacing="0" Margin="0,8,8,24" />
            </ScrollView>

            <!-- A day, named in whichever calendar the reader is thinking in. One day
                 underneath: switching sides converts it rather than starting again. -->
            <ScrollView x:Name="DatePanel" IsVisible="False">
                <VerticalStackLayout Spacing="0" Margin="0,20,0,24">

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16">
                        <Button x:Name="GregorianButton" LineBreakMode="WordWrap" Clicked="OnCalendarClicked" />
                        <Button x:Name="SolsticaButton" LineBreakMode="WordWrap" Grid.Column="1" Clicked="OnCalendarClicked" />
                    </Grid>

                    <VerticalStackLayout x:Name="GregorianSide" Spacing="0" Margin="0,16,0,0">
                        <DatePicker x:Name="Picker" Format="D" DateSelected="OnGregorianPicked"
                                    FontFamily="Plex" FontSize="17" TextColor="{DynamicResource Ink}"
                                    MinimumHeightRequest="44" HorizontalOptions="Start" />

                        <!-- In the last year the Gregorian calendar runs out before the
                             Solstica one does, and there is no date to pick. -->
                        <Label x:Name="NoGregorianLabel" IsVisible="False" FontFamily="Plex"
                               FontSize="17" TextColor="{DynamicResource Ink}" />

                        <!-- The answer to a date the calendar does not reach: a sentence,
                             not a refusal. -->
                        <Label x:Name="BeforeStartLabel" IsVisible="False" FontFamily="Plex"
                               FontSize="11.5" TextColor="{DynamicResource Muted}"
                               Margin="0,12,0,0" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SolsticaSide" IsVisible="False" Spacing="0"
                                         Margin="0,16,0,0">
                        <Entry x:Name="DateYearEntry" Keyboard="Numeric" MaxLength="5"
                               FontFamily="Plex" FontSize="28" TextColor="{DynamicResource Ink}"
                               BackgroundColor="Transparent" MinimumWidthRequest="170"
                               HorizontalOptions="Start" MinimumHeightRequest="44" />
                        <Label x:Name="DateYearRangeLabel" FontFamily="Plex" FontSize="11"
                               TextColor="{DynamicResource Muted}" Margin="2,6,0,0" />

                        <!-- Only the blocks this year has, and only the days that block has.
                             The day picker goes where there is only one day to pick. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,18,0,0">
                            <Picker x:Name="BlockPicker" SelectedIndexChanged="OnBlockPicked"
                                    FontFamily="Plex" FontSize="17" TextColor="{DynamicResource Ink}"
                                    MinimumHeightRequest="44" />
                            <Picker x:Name="DayPicker" Grid.Column="1" SelectedIndexChanged="OnDayPicked"
                                    FontFamily="Plex" FontSize="17" TextColor="{DynamicResource Ink}"
                                    MinimumHeightRequest="44" MinimumWidthRequest="90" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button x:Name="DateGoButton" LineBreakMode="WordWrap" Clicked="OnGoDateClicked"
                            FontFamily="PlexMedium" FontSize="13"
                            MinimumHeightRequest="44" Padding="20,9" CornerRadius="22"
                            BorderWidth="1" BorderColor="{DynamicResource Rule}"
                            BackgroundColor="Transparent" TextColor="{DynamicResource Ink}"
                            HorizontalOptions="Start" Margin="0,26,0,0" />

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
