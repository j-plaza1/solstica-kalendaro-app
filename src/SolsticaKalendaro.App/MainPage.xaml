<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SolsticaKalendaro.App"
             x:Class="SolsticaKalendaro.App.MainPage"
             x:Name="Page"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Paper}">

    <ContentPage.Resources>

        <!-- Each template declares a fixed height. Rows that never change size make
             scrolling by index exact, which is what going to today depends on. -->

        <DataTemplate x:Key="SectionTemplate">
            <HorizontalStackLayout Padding="20,15,20,7" Spacing="8" HeightRequest="44">
                <BoxView Color="{Binding Dot}" WidthRequest="7" HeightRequest="7"
                         CornerRadius="3.5" VerticalOptions="Center" />
                <Label Text="{Binding Name}" FontFamily="SpectralSemiBold" FontSize="16"
                       TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                <Label Text="{Binding Label}" FontFamily="Plex" FontSize="11"
                       TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="WeekTemplate">
            <Grid Padding="12,0" ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="58"
                  BindableLayout.ItemsSource="{Binding Days}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid Grid.Column="{Binding Column}" RowDefinitions="*,4" HeightRequest="58">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=OpenDay}"
                                    CommandParameter="{Binding Solstica}" />
                            </Grid.GestureRecognizers>
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Highlight}" />
                                </DataTrigger>
                            </Grid.Triggers>

                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Number}" FontFamily="Plex" FontSize="19"
                                       HorizontalOptions="Center" TextColor="{StaticResource Ink}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                            <Setter Property="FontFamily" Value="PlexSemiBold" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Gregorian}" FontFamily="Plex" FontSize="10"
                                       HorizontalOptions="Center" TextColor="{StaticResource Faint}" />
                            </VerticalStackLayout>

                            <!-- The season of the day, at its foot. It can change mid-row. -->
                            <BoxView Grid.Row="1" Color="{Binding Season}" />

                            <BoxView Grid.Row="0" Color="{StaticResource CellEdge}"
                                     WidthRequest="1" HorizontalOptions="End" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>
        </DataTemplate>

        <!-- Extra-weekly days are not cells: they cross all seven columns, because that is
             what they are. Outside the week, between the blocks. -->
        <DataTemplate x:Key="BandTemplate">
            <Grid Margin="12,6" ColumnDefinitions="4,*,4" HeightRequest="66">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:Reference Page}, Path=OpenDay}"
                        CommandParameter="{Binding Solstica}" />
                </Grid.GestureRecognizers>
                <BoxView Color="{Binding Season}" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Padding="14,13"
                      BackgroundColor="{StaticResource Highlight}">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Name}" FontFamily="SpectralSemiBold" FontSize="17"
                               TextColor="{StaticResource Accent}" />
                        <Label Text="Sense dia de la setmana" FontFamily="Plex" FontSize="11"
                               TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding Gregorian}" FontFamily="Plex" FontSize="12.5"
                           TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                </Grid>
                <BoxView Grid.Column="2" Color="{Binding Season}" />
            </Grid>
        </DataTemplate>

        <local:RowTemplateSelector x:Key="RowSelector"
                                   Section="{StaticResource SectionTemplate}"
                                   Week="{StaticResource WeekTemplate}"
                                   Band="{StaticResource BandTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- One row, because it has to keep fitting when the type grows. A second row of
             controls would come out of the grid, which is what the reader came for. -->
        <VerticalStackLayout Grid.Row="0" Padding="14,44,12,8" Spacing="0">

            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <Button x:Name="PreviousYearButton" Text="&#8249;" Clicked="OnPreviousYear"
                        SemanticProperties.Hint="Any anterior" />
                <Button x:Name="YearButton" Grid.Column="1" Clicked="OnYearClicked"
                        SemanticProperties.Hint="Tria un any, un període o una data" />
                <Button x:Name="NextYearButton" Grid.Column="2" Text="&#8250;" Clicked="OnNextYear"
                        SemanticProperties.Hint="Any següent" />

                <Button x:Name="TodayButton" Grid.Column="4" Text="Avui" Clicked="OnTodayClicked"
                        SemanticProperties.Hint="Va a la data d&apos;avui"
                        FontFamily="PlexMedium" FontSize="12"
                        MinimumHeightRequest="44" Padding="14,9" CornerRadius="22"
                        BorderWidth="1" BorderColor="{StaticResource Rule}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Muted}" />
                <Button x:Name="MenuButton" Grid.Column="5" Text="&#8942;" Clicked="OnMenuClicked"
                        SemanticProperties.Hint="Opcions, com es llegeix i quant a"
                        FontFamily="Plex" FontSize="20" TextColor="{StaticResource Muted}"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        MinimumHeightRequest="44" MinimumWidthRequest="44" />
            </Grid>

            <!-- The period of the year on screen, and the way into what that means. Before the
                 calendar begins there is no period to speak of, so it carries the wait. -->
            <HorizontalStackLayout Spacing="0" Margin="6,0,0,0">
                <Button x:Name="PeriodButton" Clicked="OnPeriodClicked"
                        FontFamily="Plex" FontSize="12" TextColor="{StaticResource Muted}"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0,6"
                        MinimumHeightRequest="32" />
                <Label x:Name="LeapLabel" FontFamily="Plex" FontSize="12" IsVisible="False"
                       TextColor="{StaticResource Muted}" VerticalOptions="Center"
                       Text=" · any de traspàs" />
                <Label x:Name="SubtitleLabel" FontFamily="Plex" FontSize="12" IsVisible="False"
                       TextColor="{StaticResource Muted}" VerticalOptions="Center" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- The Solstica week, which is not the Gregorian one: it pauses at the extra-weekly days. -->
        <Grid x:Name="WeekdayHeader" Grid.Row="1" Padding="12,6,12,7"
              ColumnDefinitions="*,*,*,*,*,*,*">
            <Label x:Name="Weekday0" />
            <Label x:Name="Weekday1" Grid.Column="1" />
            <Label x:Name="Weekday2" Grid.Column="2" />
            <Label x:Name="Weekday3" Grid.Column="3" />
            <Label x:Name="Weekday4" Grid.Column="4" />
            <Label x:Name="Weekday5" Grid.Column="5" />
            <Label x:Name="Weekday6" Grid.Column="6" />
            <BoxView Grid.ColumnSpan="7" Color="{StaticResource Hairline}"
                     HeightRequest="1" VerticalOptions="End" Margin="0,0,0,-7" />
        </Grid>

        <CollectionView x:Name="Rows" Grid.Row="2" ItemTemplate="{StaticResource RowSelector}" />
    </Grid>

</ContentPage>
