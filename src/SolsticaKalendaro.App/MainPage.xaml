<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SolsticaKalendaro.App"
             x:Class="SolsticaKalendaro.App.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- One row, because it has to keep fitting when the type grows. A second row of
             controls would come out of the grid, which is what the reader came for. -->
        <VerticalStackLayout Grid.Row="0" Padding="14,10,12,8" Spacing="0">

            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <Button x:Name="PreviousYearButton" Text="&#8249;" Clicked="OnPreviousYear" />

                <Grid Grid.Column="1">
                    <Button x:Name="YearButton" Clicked="OnYearClicked" />
                    <Path Data="M 0,0 L 5,4.5 L 10,0" Stroke="#1C1A17"
                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeLineJoin="Round"
                          WidthRequest="10" HeightRequest="5"
                          HorizontalOptions="End" VerticalOptions="Center"
                          Margin="0,3,8,0" InputTransparent="True" />
                </Grid>

                <Button x:Name="NextYearButton" Grid.Column="2" Text="&#8250;" Clicked="OnNextYear" />

                <Button x:Name="TodayButton" LineBreakMode="WordWrap" Grid.Column="4" Clicked="OnTodayClicked"
                        FontFamily="PlexMedium" FontSize="12"
                        MinimumHeightRequest="44" Padding="14,9" CornerRadius="22"
                        BorderWidth="1" BorderColor="{StaticResource Rule}"
                        BackgroundColor="Transparent" TextColor="{StaticResource Muted}" />
                <Button x:Name="MenuButton" Grid.Column="5" Text="&#8942;" Clicked="OnMenuClicked"
                        FontFamily="Plex" FontSize="20" TextColor="{StaticResource Muted}"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        MinimumHeightRequest="44" MinimumWidthRequest="44" />
            </Grid>

            <!-- The period of the year on screen, and the way into what that means. Before the
                 calendar begins there is no period to speak of, so it carries the wait. -->
            <HorizontalStackLayout Spacing="0" Margin="6,0,0,0">
                <Label x:Name="PrefixLabel" FontFamily="Plex" FontSize="12" IsVisible="False"
                       TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                <Button x:Name="PeriodButton" Clicked="OnPeriodClicked"
                        FontFamily="Plex" FontSize="12" TextColor="{StaticResource Muted}"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0,6"
                        MinimumHeightRequest="32" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- The Solstica week, which is not the Gregorian one: it pauses at the extra-weekly
             days. Built in code, and shared with the introduction's example, because the rest
             days shade their columns here too. -->
        <ContentView x:Name="Weekdays" Grid.Row="1" />

        <CollectionView x:Name="Rows" Grid.Row="2" ItemTemplate="{StaticResource RowSelector}" />

        <!-- Anchored under the button that opens it, and dismissed by tapping anywhere else.
             A dialog would take the screen and need a button to give it back. -->
        <Grid x:Name="MenuOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissMenu" />
            </Grid.GestureRecognizers>

            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,56,12,0"
                    WidthRequest="210" Padding="0,6"
                    BackgroundColor="{StaticResource Paper}"
                    Stroke="{StaticResource Rule}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                <VerticalStackLayout>
                    <Button x:Name="OptionsItem" Clicked="OnOptionsClicked" />
                    <Button x:Name="HowToReadItem" Clicked="OnHowToReadClicked" />
                    <Button x:Name="AboutItem" Clicked="OnAboutClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
